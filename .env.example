# Google OAuth 2.0 Credentials
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gmail-mcp-web-client.vercel.app/api/auth/callback

# 32-byte hexadecimal encryption key for encrypting credentials at rest (generate via: openssl rand -hex 32)
ENCRYPTION_KEY=

# Secret key used for signing session tokens and OAuth state parameter (generate via: openssl rand -hex 32)
MCP_AUTH_SECRET=

# Runtime Environment
NODE_ENV=development
PORT=3000

# Supabase Credentials (Required in production for persistent TokenStore and cryptographic JWT authentication)
# Project URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL=
# Service role / secret key (used strictly server-side, never exposed to clients)
SUPABASE_SECRET_KEY=
# Supabase Publishable Key
SUPABASE_PUBLISHABLE_KEY=
# Supabase JWKS endpoint for verifying JWT signatures (e.g. https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=
